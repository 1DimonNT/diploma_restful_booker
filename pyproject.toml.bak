[tool.ruff]
line-length = 120
target-version = "py312"

[tool.ruff.lint]
select = [
    "E",   # pycodestyle errors
    "W",   # pycodestyle warnings
    "F",   # pyflakes
    "I",   # isort
    "C",   # flake8-comprehensions
    "B",   # flake8-bugbear
    "UP",  # pyupgrade
    "SIM", # flake8-simplify
    "TID", # flake8-tidy-imports
    "RUF", # ruff specific rules
]
ignore = [
    "E501",  # line too long (handled by formatter)
    "B008",  # do not perform function calls in argument defaults
    "SIM105", # use context manager for suppressed exception
]

[tool.ruff.lint.per-file-ignores]
"tests/**/*.py" = ["S101"]  # assert used in tests
"conftest.py" = ["S101"]

[tool.ruff.format]
quote-style = "double"
indent-style = "space"
skip-magic-trailing-comma = false
line-ending = "auto"

[tool.pytest.ini_options]
minversion = "7.0"
testpaths = ["api/tests", "ui/tests", "mobile/tests"]
python_files = "test_*.py"
python_classes = "Test*"
python_functions = "test_*"
addopts = "-v --strict-markers --alluredir=allure-results --clean-alluredir"
markers = [
    "api: API tests",
    "ui: UI tests",
    "mobile: Mobile tests",
    "smoke: Smoke tests",
    "regression: Regression tests",
    "critical: Critical severity",
    "major: Major severity",
    "minor: Minor severity",
]

[tool.coverage.run]
source = ["api", "ui", "mobile", "utils"]
omit = ["*/tests/*", "*/__pycache__/*"]

[tool.coverage.report]
exclude_lines = [
    "pragma: no cover",
    "def __repr__",
    "raise AssertionError",
    "raise NotImplementedError",
    "if __name__ == .__main__.:",
] 
[tool.ruff.lint] 
ignore = ["RUF001", "RUF002", "RUF003", "E722", "B904"] 
